#!/bin/sh
# Socle de paquets. Rejoué uniquement si ce fichier change (run_once_).
set -eu

log() { printf '\033[1;34m::\033[0m %s\n' "$1"; }

{{ if eq .chezmoi.os "darwin" -}}
if ! command -v brew >/dev/null 2>&1; then
    printf '\033[1;31m!!\033[0m Homebrew requis : https://brew.sh\n' >&2
    exit 1
fi

log "Paquets Homebrew"
# go et pre-commit : hook gitleaks du dépôt dotfiles (.pre-commit-config.yaml).
# jq : statusline et hooks de Claude Code (dot_claude/).
brew install --quiet zsh git neovim fzf zoxide bat spaceship go pre-commit jq
{{- else -}}
log "Paquets pacman"
# ttf-roboto-mono-nerd : la police de tout le système, cf. script 50-font.
# go et pre-commit : hook gitleaks du dépôt dotfiles (.pre-commit-config.yaml).
# jq : statusline et hooks de Claude Code (dot_claude/).
sudo pacman -S --needed --noconfirm zsh git neovim fzf zoxide bat \
    ttf-roboto-mono-nerd go pre-commit jq

# spaceship n'est que dans l'AUR. yay est fourni par Omarchy.
if command -v yay >/dev/null 2>&1; then
    log "spaceship-prompt (AUR)"
    yay -S --needed --noconfirm spaceship-prompt
else
    printf '\033[1;33m..\033[0m yay absent : installe spaceship-prompt manuellement\n' >&2
fi
{{- end }}
