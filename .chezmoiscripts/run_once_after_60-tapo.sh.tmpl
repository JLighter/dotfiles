#!/bin/sh
# Domotique Tapo : environnement Python de `tapo-ctl` et mot de passe du compte.
#
# `tapo-ctl` parle aux ampoules en local (protocole KLAP, sans passer par le
# cloud TP-Link) via python-kasa. La bibliothèque vit dans un venv dédié plutôt
# qu'en paquet système : le shebang de ~/.local/bin/tapo-ctl pointe droit
# dessus, ce qui met le script à l'abri des mises à jour de python d'Arch.
#
# Le mot de passe du compte Tapo est réclamé ici, et nulle part ailleurs : il
# n'a sa place ni dans le dépôt, ni dans ~/.config/chezmoi/chezmoi.toml, qui
# sont tous deux du texte en clair. Il finit dans le trousseau, d'où
# `tapo-ctl` le relit à chaque appel via `secret-tool`.
#
# Rejoué uniquement si ce fichier change (run_once_).
set -eu

VENV="$HOME/.local/share/tapo-ctl/venv"
KEYRING_SERVICE="tapo-ctl"
# Version figée : c'est elle qui a servi à mesurer les paramètres de protocole
# inscrits dans devices.json (cf. le champ _note).
KASA_VERSION="0.10.2"
TAPO_USERNAME="{{ dig "tapo" "username" "" . }}"

log()  { printf '\033[1;34m::\033[0m %s\n' "$1"; }
warn() { printf '\033[1;33m..\033[0m %s\n' "$1" >&2; }

# ── Applicabilité ────────────────────────────────────────────────────────────
# Pas de compte renseigné au `chezmoi init` : la machine n'a pas de domotique.
# `chezmoi init` à nouveau pour changer d'avis.
[ -n "$TAPO_USERNAME" ] || exit 0

if ! command -v python3 >/dev/null 2>&1; then
    warn "python3 absent : tapo-ctl ne sera pas fonctionnel"
    exit 0
fi

# ── Environnement Python ─────────────────────────────────────────────────────
if [ -x "$VENV/bin/python" ] && "$VENV/bin/python" -c 'import kasa' 2>/dev/null; then
    log "venv tapo-ctl déjà en place"
else
    log "Création du venv tapo-ctl (python-kasa $KASA_VERSION)"
    python3 -m venv "$VENV"
    "$VENV/bin/pip" install --quiet --upgrade pip
    "$VENV/bin/pip" install --quiet "python-kasa==$KASA_VERSION"
fi

# ── Mot de passe du compte Tapo ──────────────────────────────────────────────
if ! command -v secret-tool >/dev/null 2>&1; then
    warn "secret-tool absent (paquet libsecret) : mot de passe Tapo non enregistré"
    warn "Après installation : secret-tool store --label='Tapo' service $KEYRING_SERVICE username $TAPO_USERNAME"
    exit 0
fi

# Rappel affiché chaque fois qu'on renonce à demander le mot de passe. Ce script
# porte le préfixe `run_once_` : chezmoi retient qu'il a tourné dès qu'il sort en
# 0, et ne le rejouera pas. Abandonner sans laisser la commande sous les yeux
# reviendrait donc à laisser la domotique muette sans plus rien pour la réparer.
manual_hint() {
    warn "À enregistrer soi-même avec :"
    warn "  secret-tool store --label='Tapo' service $KEYRING_SERVICE username $TAPO_USERNAME"
}

# Range le mot de passe du compte Tapo dans le trousseau.
#
# Renvoie 0 si le mot de passe est en place à la sortie, 1 sinon. L'appelant
# n'en fait qu'un message : un mot de passe manquant rend les lampes
# injoignables, ce qui ne justifie pas d'interrompre le déploiement de tout le
# reste de la machine. La fonction est donc appelée depuis un `if`, où `set -e`
# ne s'applique pas.
store_tapo_password() {
    # Déjà présent : on n'y touche pas. Redemander à chaque `apply` userait la
    # patience, et un mot de passe erroné se corrige avec la commande ci-dessus.
    if secret-tool lookup service "$KEYRING_SERVICE" username "$TAPO_USERNAME" >/dev/null 2>&1; then
        log "Mot de passe Tapo déjà dans le trousseau"
        return 0
    fi

    # `bootstrap.sh` peut tourner derrière un `curl | sh`, où stdin est le script
    # lui-même : une saisie masquée y avalerait les lignes suivantes.
    if [ ! -t 0 ]; then
        warn "Pas de terminal : mot de passe Tapo non demandé"
        manual_hint
        return 1
    fi

    # `read -s` est un bashisme ; ce script est en /bin/sh, d'où le passage par
    # `stty`. L'écho est coupé AVANT d'afficher l'invite, et non après : entre
    # les deux, tout caractère déjà en attente s'afficherait en clair — ce qui
    # arrive dès qu'un mot de passe est collé depuis un gestionnaire plutôt que
    # tapé. Le trap est posé en premier pour que Ctrl-C ne laisse jamais un
    # terminal aveugle derrière lui.
    trap 'stty echo 2>/dev/null; printf "\n" >&2; exit 130' INT TERM
    if ! stty -echo 2>/dev/null; then
        trap - INT TERM
        warn "Impossible de masquer la saisie : mot de passe Tapo non demandé"
        manual_hint
        return 1
    fi
    printf 'Mot de passe du compte Tapo (%s) : ' "$TAPO_USERNAME" >&2
    IFS= read -r password || password=""
    stty echo 2>/dev/null || true
    trap - INT TERM
    printf '\n' >&2

    if [ -z "$password" ]; then
        warn "Saisie vide : mot de passe Tapo non enregistré"
        manual_hint
        return 1
    fi

    # Le mot de passe transite par stdin, jamais par un argument : `ps` expose la
    # ligne de commande de tous les processus, y compris à un autre utilisateur.
    # Un trousseau verrouillé ou absent (session SSH sans D-Bus) fait échouer
    # `store` — d'où le rattrapage plutôt qu'une sortie en erreur.
    if printf '%s' "$password" | secret-tool store --label='Tapo' \
        service "$KEYRING_SERVICE" username "$TAPO_USERNAME" 2>/dev/null; then
        log "Mot de passe Tapo enregistré dans le trousseau"
    else
        warn "Trousseau inaccessible : mot de passe Tapo non enregistré"
        manual_hint
        return 1
    fi
}

if store_tapo_password; then
    log "Domotique Tapo prête"
else
    warn "Domotique Tapo incomplète : les lampes resteront injoignables"
fi
