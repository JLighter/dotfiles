{
  "schemaVersion": 1,
  "id": "local.vpn",
  "name": "VPN",
  "version": "1.0.0",
  "author": "jlighter",
  "license": "MIT",
  "description": "État des tunnels WireGuard gérés par NetworkManager, et accès au sélecteur omarchy-vpn.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Widget.qml"
  },
  "barWidget": {
    "displayName": "VPN",
    "description": "Affiche les tunnels WireGuard actifs et ouvre le sélecteur au clic.",
    "category": "Network",
    "allowMultiple": false,
    "defaults": {
      "refreshIntervalSec": 15
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 3600,
        "step": 5,
        "defaultValue": 15
      }
    ]
  }
}
