onboarding = false
# ════════════════════════════════════════════════════════════
# Herdr — configuration migrée depuis ~/.tmux.conf
# Défauts complets : `herdr --default-config`
# Recharger : prefix+shift+R ou `herdr server reload-config`
# ════════════════════════════════════════════════════════════

[theme]
# Catppuccin, comme dans tmux. auto_switch suit le thème clair/sombre du
# terminal hôte (Ghostty window-theme = auto) — remplace les hooks tmux
# client-dark-theme / client-light-theme + reload-theme.sh.
name = "catppuccin"
auto_switch = false
dark_name = "catppuccin"
light_name = "catppuccin-latte"

[keys]
# Même prefix que dans tmux (C-space au lieu du C-b par défaut de herdr).
prefix = "ctrl+space"

# Splits : mêmes touches que dans tmux — « / » côte à côte, « - » empilé.
# Le cwd suit le pane courant (new_cwd = "follow", défaut) — équivalent
# de -c "#{pane_current_path}".
split_vertical = "prefix+/"
split_horizontal = "prefix+minus"

# Renommer le tab : prefix+, comme le rename-window de tmux
# (remplace le prefix+shift+T par défaut).
rename_tab = "prefix+comma"

# Worktrees : ouvrir / retirer un workspace adossé à un git worktree
# (créer = prefix+shift+G, défaut — un agent par branche, en parallèle).
open_worktree = "prefix+shift+o"
remove_worktree = "prefix+shift+minus"

# Zoom du pane courant sur prefix+z, comme dans tmux. Le « mode zen »
# (sidebar repliée, masquée entièrement via sidebar_collapsed_mode =
# "hidden" plus bas) part sur prefix+b, le défaut herdr.
zoom = "prefix+z"
toggle_sidebar = "prefix+b"

# Cycler entre les agents, tous workspaces confondus.
next_agent = "prefix+a"
previous_agent = "prefix+shift+a"

# ── Panneau workspace (mode navigate) en vim ──────────────────────────
# alt+w (Option gauche + w — macos-option-as-alt = left dans Ghostty)
# ouvre la liste des workspaces de la sidebar, en plus du prefix+w par
# défaut. Dedans : j/k parcourt la liste, enter bascule, esc sort, et
# ctrl+h/j/k/l déplace le focus de pane (miroir des chords globaux).
# ctrl+h direct au bord gauche ne peut PAS déborder sur la sidebar :
# un chord direct n'a qu'un comportement global dans herdr.
{{ if eq .chezmoi.os "darwin" -}}
workspace_picker = ["prefix+w", "alt+w"]
{{- else -}}
# Sur Omarchy, ALT est le modificateur d'Hyprland (couche i3) : il capte alt+w
# avant herdr. Seul prefix+w subsiste.
workspace_picker = ["prefix+w"]
{{- end }}
navigate_workspace_down = "j"
navigate_workspace_up = "k"
navigate_pane_left = "ctrl+h"
navigate_pane_down = "ctrl+j"
navigate_pane_up = "ctrl+k"
navigate_pane_right = "ctrl+l"

# Onglets en accès direct : alt+1..9 (en plus du prefix+1..9 par défaut).
# Sous Ghostty/macOS, ne répond que si la touche Option envoie Alt
# (macos-option-as-alt) — sinon prefix+1..9 reste la voie normale.
{{ if eq .chezmoi.os "darwin" -}}
[keys.indexed]
tabs = "alt"
{{- else -}}
# Pas de tabs = "alt" ici : Hyprland capte alt+1..9 pour ses workspaces, herdr
# ne les recevrait jamais. prefix+1..9 reste la voie d'accès aux onglets.
{{- end }}

# ── Navigation vim-like ctrl+h/j/k/l (plugin vim-herdr-navigation) ────
# Bindings directs (sans prefix) vers le plugin : si le pane focalisé
# exécute (n)vim, la touche lui est transmise (splits vim) et vim rappelle
# herdr au bord d'un split ; sinon herdr change de pane directement.
# prefix+h/j/k/l (défaut) reste disponible en secours.
[[keys.command]]
key = "ctrl+h"
type = "plugin_action"
command = "vim-herdr-navigation.left"
description = "navigate left (vim/herdr)"

[[keys.command]]
key = "ctrl+j"
type = "plugin_action"
command = "vim-herdr-navigation.down"
description = "navigate down (vim/herdr)"

[[keys.command]]
key = "ctrl+k"
type = "plugin_action"
command = "vim-herdr-navigation.up"
description = "navigate up (vim/herdr)"

[[keys.command]]
key = "ctrl+l"
type = "plugin_action"
command = "vim-herdr-navigation.right"
description = "navigate right (vim/herdr)"

# ── Popups (équivalent display-popup de tmux) ─────────────────────────
# Lancer un agent : popup du plugin herdr-spawn (prompt + historique,
# worktree + workspace + agent). Config : herdr plugin config-dir herdr-spawn.
[[keys.command]]
key = "prefix+enter"
type = "plugin_action"
command = "herdr-spawn.open"
description = "lancer un agent (worktree + prompt)"

[[keys.command]]
key = "prefix+f"
type = "popup"
command = "yazi"
width = "85%"
height = "85%"

[[keys.command]]
key = "prefix+m"
type = "popup"
command = "btop"
width = "90%"
height = "90%"

[worktrees]
directory = "~/.herdr/worktrees"

[ui]
# "spaces" : agents groupés par workspace dans la sidebar — la hiérarchie
# projet → agents reste visible en permanence (branche git par workspace).
# La file d'attention des agents bloqués reste accessible à la demande :
# prefix+g puis « b » (filtre blocked du navigator).
agent_panel_sort = "spaces"

# Barre d'onglets masquée quand le workspace n'a qu'un onglet.
hide_tab_bar_when_single_tab = true

# Sidebar repliée = totalement masquée (largeur zéro), pas de rail compact —
# combiné à toggle_sidebar (prefix+z), c'est le « mode zen ».
sidebar_collapsed_mode = "hidden"

show_agent_labels_on_pane_borders = true

# Entrées agents de la sidebar, pour Claude : le workspace en gras (le
# « projet ») puis le titre de session Claude Code (ce que l'agent fait)
# — plus parlant que « claude » répété quand tous les agents sont Claude.
[ui.sidebar.agents.rows_by_agent]
claude = [["state_icon", { token = "workspace", bold = true }, "tab"], ["terminal_title_stripped"]]

[ui.toast]
# Notifications de bureau relayées au terminal hôte (Ghostty) — remplace
# allow-passthrough de tmux pour les notifications Claude Code.
delivery = "system"

[experimental]
switch_ascii_input_source_in_prefix = true
# Restaure le contenu affiché des panes après un redémarrage complet du
# serveur (complète resume_agents_on_restore, actif par défaut).
pane_history = true
