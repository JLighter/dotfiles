# Claude Code internal state — do not version
backups/
cache/
chrome/
debug/
downloads/
file-history/
ide/
logs/
paste-cache/
plans/
plugins/*
projects/
session-env/
sessions/
shell-snapshots/
statsig/
tasks/
telemetry/
todos/

# Sauf la config du HUD, qui est un réglage et non un cache.
# `plugins/*` plutôt que `plugins/` plus haut : git ne redescend pas dans un
# répertoire exclu, une négation seule n'aurait donc jamais été évaluée.
!plugins/claude-hud/
plugins/claude-hud/*
!plugins/claude-hud/config.json

# History and stats
history.jsonl
stats-cache.json

# Settings backup
settings.json.bak

# OS files
.DS_Store
