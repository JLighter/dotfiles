{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "deny": ["Bash(git commit --no-verify:*)", "Bash(git commit -n:*)"]
  }
}
