{{- /* Chemins relatifs à $HOME (cible), pas au dépôt source. */ -}}

# ── Fichiers du dépôt qui ne doivent pas atterrir dans $HOME ──────────────────
Readme.md
bootstrap.sh

# Une session Claude Code ouverte ici pose des fichiers vides à la racine pour
# empêcher un gestionnaire de paquets de remonter au-dessus du projet. Elle les
# masque à git via .git/info/exclude, mais chezmoi lit le disque : sans ces
# lignes il les prend pour des sources et bloque l'`apply` sur une confirmation
# TTY. Voir la section « claude-code scrub-mode stubs » de .git/info/exclude.
# Les stubs commençant par un point (.npmrc, .yarnrc…) n'ont pas besoin d'y
# figurer : chezmoi ignore déjà tout fichier source commençant par un point.
bunfig.toml
package.json
package-lock.json
yarn.lock
pnpm-lock.yaml

{{ if ne .chezmoi.os "darwin" }}
# ── macOS uniquement ─────────────────────────────────────────────────────────
.hushlogin
{{ end }}

{{ if ne .chezmoi.os "linux" }}
# ── Omarchy / Linux uniquement ───────────────────────────────────────────────
# Overrides Hyprland & co : ne doivent jamais être déployés sur macOS.
# waybar / walker / mako ont disparu avec le passage au shell Quickshell : les
# lignes correspondantes ont été retirées plutôt que gardées « au cas où ».
.config/hypr
.config/omarchy
.config/tapo-ctl
.local/bin/tapo-ctl
{{ end }}

{{ if not (dig "tapo" "username" "" .) }}
# ── Domotique Tapo ───────────────────────────────────────────────────────────
# Aucun compte Tapo renseigne au `chezmoi init` : rien de la domotique n'est
# depose. Le widget Tapo.qml, lui, reste deploye — Bar.qml l'instancie en dur —
# mais il se retire de lui-meme de la barre tant que `tapo-ctl` est absent.
.config/tapo-ctl
.local/bin/tapo-ctl
.config/omarchy/hooks/theme-set.d/tapo-lamps
{{ end }}
